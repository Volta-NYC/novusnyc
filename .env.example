# Canonical public URL — www is canonical (the apex 301s to www)
NEXT_PUBLIC_SITE_URL=https://www.novusnyc.org

# CARTO basemap key for the public Showcase vector map
NEXT_PUBLIC_CARTO_BASEMAP_KEY=your-carto-basemap-key

# Google Apps Script Web App URL (deployed as public web app)
# Deploy scripts/SheetsLogger.gs and paste the URL here
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Backward-compatible fallback; prefer APPS_SCRIPT_URL for new deployments
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# The Google Drive Folder ID for resume uploads (optional)
DRIVE_FOLDER_ID=your_folder_id_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Abuse guardrails (server-side)
# Form submit limits
FORM_RATE_LIMIT_PER_IP=8
FORM_RATE_LIMIT_PER_EMAIL=5
FORM_RATE_LIMIT_WINDOW_SEC=3600

# Resume upload limits
RESUME_UPLOAD_RATE_LIMIT_PER_IP=5
RESUME_UPLOAD_RATE_LIMIT_WINDOW_SEC=3600

# Member signup limits
SIGNUP_RATE_LIMIT_PER_IP=5
SIGNUP_RATE_LIMIT_PER_EMAIL=3
SIGNUP_RATE_LIMIT_WINDOW_SEC=86400

# Outgoing email (SMTP)
# One Google Workspace mailbox sends for every address. It must be a mailbox on
# novusnyc.org — a consumer @gmail.com account DKIM-signs d=gmail.com, which
# never aligns with a From: address on this domain and so always fails DMARC.
# SMTP_PASS is a 16-character Google App Password with the spaces removed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=someone@novusnyc.org
SMTP_PASS=your-app-password
EMAIL_FROM=info@novusnyc.org
EMAIL_REPLY_TO=info@novusnyc.org

# Optional. Both default to exactly the four addresses in src/lib/mail.ts with
# their per-sender display names, so leave them unset unless you are deviating.
# Setting TEAM_EMAIL_FROM_NAME instead forces ONE display name onto every
# address — it is legacy, and EMAIL_FROM_NAMES supersedes it.
# TEAM_EMAIL_ALLOWED_FROM=info@novusnyc.org,ethan@novusnyc.org,andrew@novusnyc.org,tahmid@novusnyc.org
# EMAIL_FROM_NAMES=info@novusnyc.org=Novus NYC,ethan@novusnyc.org=Ethan Zhang
