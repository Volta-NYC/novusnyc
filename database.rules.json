{
  "rules": {
    ".read": false,
    ".write": false,

    "businesses": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["projectStatus", "showcaseEnabled", "ownerEmail", "createdAt"]
    },

    "businessImages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "bids": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "createdAt"]
    },

    "team": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["email", "alternateEmail", "status", "pod"]
    },

    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "projects": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["businessId", "status"]
    },

    "financeAssignments": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "type"]
    },

    "calendarEvents": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["start"]
    },

    "applications": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      ".indexOn": ["email", "status", "createdAt", "interviewSlotId"]
    },

    "userProfiles": {
      ".read": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".indexOn": ["email"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "inviteCodes": {
      ".read": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      "$code": {
        ".read": true
      }
    },

    "interviewSlots": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      ".indexOn": ["datetime", "available"]
    },

    "interviewInvites": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      "$token": {
        ".read": true
      }
    },

    "interviewSettings": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin' || root.child('userProfiles').child(auth.uid).child('authRole').val() === 'interviewer')"
    },

    "auditLogs": {
      ".read": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "cycles": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".indexOn": ["active", "startDate"]
    },

    "infractions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'"
    },

    "emailTemplates": {
      ".read": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'"
    },

    "assignmentCatalog": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".indexOn": ["cycleId", "status", "primaryTrack"]
    },

    "assignmentClaims": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["memberId", "cycleId", "status", "assignmentId"]
    },

    "memberStrikes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".indexOn": ["memberId", "cycleId"]
    },

    "memberCreditAdjustments": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('authRole').val() === 'admin'",
      ".indexOn": ["memberId", "cycleId"]
    },

    "abuseGuards": {
      ".read": false,
      ".write": false
    }
  }
}
